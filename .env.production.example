# ============================================================
# SIKEBUT App (Next.js) — contoh isi .env.production
# Salin lalu isi:  cp .env.production.example .env.production
# Berkas ini WAJIB ada, karena docker-compose.yml memakai
#   env_file: - .env.production
# dan Compose menolak jalan bila berkasnya tidak ada.
# ============================================================

# --- Runtime dasar ---
NODE_ENV=production
PORT=3000

# --- Sesi login NextAuth (WAJIB) ---
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# --- Alamat publik aplikasi ---
# Dipakai NextAuth untuk redirect setelah login. Harus SAMA dengan alamat yang
# dibuka pengguna (termasuk https), kalau tidak login akan gagal/berputar.
AUTH_URL=https://risfiatuladawiyah.my.id
NEXTAUTH_URL=https://risfiatuladawiyah.my.id

# --- Alamat backend Laravel DARI DALAM container ---
# JANGAN pakai 127.0.0.1 (itu menunjuk container frontend sendiri).
# Di Docker: nama container nginx backend pada network app-network.
# Untuk menjalankan tanpa Docker (dev lokal), pakai http://127.0.0.1:8000
API_URL=http://sikebut-api-nginx:80

# --- Label lingkungan ---
NEXT_PUBLIC_APP_ENV=production
